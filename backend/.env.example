APP_NAME=BoardingFinder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match where this API is served: it is used to build absolute URLs for uploaded photos.
APP_URL=http://localhost:8800

# The React app's origin (CORS + credentialed cookies).
CLIENT_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# SQLite works out of the box (run `touch database/database.sqlite`). For MySQL, comment the
# next line out and fill in the DB_* values below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=boardingfinder
# DB_USERNAME=root
# DB_PASSWORD=
#
# PostgreSQL works the same way (the CI suite runs on SQLite, MySQL and PostgreSQL):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=boardingfinder
# DB_USERNAME=postgres
# DB_PASSWORD=

# The API is stateless (cookie-carried Sanctum tokens), so no session store is needed.
SESSION_DRIVER=array
CACHE_STORE=file
FILESYSTEM_DISK=local
# `sync` sends emails inline. Use `database` (and run `php artisan queue:work`) in production.
QUEUE_CONNECTION=sync

# --- Real-time (Laravel Reverb) ------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=boardingfinder
REVERB_APP_KEY=boardingfinder-local-key
REVERB_APP_SECRET=boardingfinder-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Email notifications (optional) --------------------------------------
# `log` writes emails to storage/logs instead of sending, and the app skips mail entirely.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=alerts@boardingfinder.test
MAIL_FROM_NAME="${APP_NAME}"

# --- AI features (optional) ----------------------------------------------
# Listing description generator and room-photo check.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
